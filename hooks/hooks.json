{
  "description": "Lightweight North Starr routing and architecture-artifact reminders for Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/codex-user-prompt-submit.sh",
            "timeout": 5,
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/codex-pre-tool-use-ai-artifacts.sh",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
