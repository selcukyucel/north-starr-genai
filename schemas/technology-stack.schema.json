{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selcukyucel/north-starr-genai/schemas/technology-stack.schema.json",
  "title": "North Starr technology stack decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "engagement_id",
    "generated_at",
    "status",
    "source_hashes",
    "runtime",
    "sdk_decision",
    "components",
    "model_decision",
    "platform_components",
    "assumptions",
    "open_questions",
    "human_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "technology_stack_decision" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["proposed", "stale", "rejected", "accepted"] },
    "source_hashes": { "$ref": "#/$defs/hashes" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "deployment_target", "selection_status"],
      "properties": {
        "language": { "type": ["string", "null"] },
        "deployment_target": { "type": ["string", "null"] },
        "selection_status": { "enum": ["selected", "spike_required", "unknown"] }
      }
    },
    "sdk_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "selection_status", "selected_candidate", "rationale", "requirements", "candidates"],
      "properties": {
        "category": {
          "enum": [
            "no_agent_sdk",
            "provider_sdk",
            "portable_ai_sdk",
            "agent_sdk",
            "durable_workflow_runtime",
            "graph_runtime"
          ]
        },
        "selection_status": { "enum": ["not_needed", "selected", "spike_required"] },
        "selected_candidate": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fit", "gaps", "evidence_url", "verified_at"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "fit": { "type": "array", "items": { "type": "string" } },
              "gaps": { "type": "array", "items": { "type": "string" } },
              "evidence_url": { "type": ["string", "null"], "format": "uri" },
              "verified_at": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_client",
        "structured_output_validation",
        "orchestration",
        "workflow_runtime",
        "mcp_integration",
        "evaluation",
        "tracing",
        "secrets",
        "persistence"
      ],
      "properties": {
        "provider_client": { "$ref": "#/$defs/componentDecision" },
        "structured_output_validation": { "$ref": "#/$defs/componentDecision" },
        "orchestration": { "$ref": "#/$defs/componentDecision" },
        "workflow_runtime": { "$ref": "#/$defs/componentDecision" },
        "mcp_integration": { "$ref": "#/$defs/componentDecision" },
        "evaluation": { "$ref": "#/$defs/componentDecision" },
        "tracing": { "$ref": "#/$defs/componentDecision" },
        "secrets": { "$ref": "#/$defs/componentDecision" },
        "persistence": { "$ref": "#/$defs/componentDecision" }
      }
    },
    "model_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "selected_model", "requirements", "benchmark_plan"],
      "properties": {
        "selection_status": { "enum": ["benchmark_required", "selected"] },
        "selected_model": { "type": ["string", "null"] },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality",
            "p50_latency",
            "p95_latency",
            "cost",
            "context",
            "capabilities",
            "tool_behavior",
            "portability",
            "data_region",
            "snapshot_pinning"
          ],
          "properties": {
            "quality": { "type": ["string", "number", "null"] },
            "p50_latency": { "type": ["string", "number", "null"] },
            "p95_latency": { "type": ["string", "number", "null"] },
            "cost": { "type": ["string", "number", "null"] },
            "context": { "type": ["string", "number", "null"] },
            "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "tool_behavior": { "type": ["string", "null"] },
            "portability": { "type": ["string", "null"] },
            "data_region": { "type": ["string", "null"] },
            "snapshot_pinning": { "type": ["string", "null"] }
          }
        },
        "benchmark_plan": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "platform_components": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "human_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "componentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_status",
        "category",
        "selected_candidate",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "selection_status": {
          "enum": [
            "not_needed",
            "selected",
            "spike_required",
            "benchmark_required",
            "unknown"
          ]
        },
        "category": { "type": ["string", "null"] },
        "selected_candidate": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "uniqueItems": true
    }
  }
}
