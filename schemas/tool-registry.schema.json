{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selcukyucel/north-starr-genai/schemas/tool-registry.schema.json",
  "title": "North Starr tool and MCP registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "engagement_id",
    "generated_at",
    "status",
    "source_hashes",
    "servers",
    "human_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "tool_registry" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["proposed", "partial", "ready", "stale"] },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "uniqueItems": true
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    },
    "human_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "name",
        "kind",
        "capture_status",
        "endpoint",
        "transport",
        "owner",
        "trust_boundary",
        "authentication",
        "tenant_boundary",
        "version_policy",
        "tools",
        "evidence_refs",
        "open_questions",
        "unknown_fields"
      ],
      "properties": {
        "server_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "kind": { "enum": ["mcp", "api", "database", "connector", "other", "unknown"] },
        "capture_status": { "enum": ["confirmed", "partial", "mentioned", "unknown"] },
        "endpoint": { "type": ["string", "null"] },
        "transport": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "trust_boundary": { "type": ["string", "null"] },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "scopes"],
          "properties": {
            "method": { "type": ["string", "null"] },
            "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "tenant_boundary": { "type": ["string", "null"] },
        "version_policy": { "type": ["string", "null"] },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "unknown_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "capture_status",
        "name",
        "purpose",
        "authoritative_source",
        "action_class",
        "allowed_actors",
        "approval_required",
        "timeout_ms",
        "retry_policy",
        "idempotency",
        "quota",
        "failure_behavior",
        "data_classification",
        "result_sanitization",
        "audit_fields",
        "contract_tests",
        "evidence_refs",
        "unknown_fields"
      ],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "capture_status": { "enum": ["confirmed", "partial", "mentioned", "unknown"] },
        "name": { "type": ["string", "null"], "minLength": 1 },
        "purpose": { "type": ["string", "null"], "minLength": 1 },
        "authoritative_source": { "type": ["string", "null"] },
        "action_class": { "enum": ["read", "write", "side_effect", "destructive", "unknown"] },
        "allowed_actors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "approval_required": { "type": ["boolean", "null"] },
        "timeout_ms": { "type": ["integer", "null"], "minimum": 1 },
        "retry_policy": { "type": ["string", "null"] },
        "idempotency": { "type": ["string", "null"] },
        "quota": { "type": ["string", "null"] },
        "failure_behavior": { "type": ["string", "null"] },
        "data_classification": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "result_sanitization": { "type": ["string", "null"] },
        "audit_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "contract_tests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unknown_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
